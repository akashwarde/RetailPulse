POSTGRES_USER=retail
POSTGRES_PASSWORD=replace_with_a_strong_password
SOURCE_DB=source_db
WAREHOUSE_DB=warehouse_db
MINIO_ROOT_USER=retailadmin
MINIO_ROOT_PASSWORD=replace_with_another_strong_password
AIRFLOW_UID=50000

# Optional overrides for local / host execution (defaults shown)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# MINIO_ENDPOINT=localhost:9000
# MINIO_SECURE=false
# MINIO_BUCKET=retailpulse
# LOG_LEVEL=INFO

# Streaming (Redpanda / Kafka)
# Host applications connect via localhost:19092; containers connect via redpanda:9092
# REDPANDA_BROKER=localhost:19092
# REDPANDA_CONTAINER_BROKER=redpanda:9092
# REDPANDA_ORDERS_TOPIC=orders_stream
# REDPANDA_DLQ_TOPIC=orders_dlq

# Order Producer settings
# PRODUCER_RATE_PER_SEC=5.0
# PRODUCER_INVALID_RATE=0.03
# PRODUCER_LATE_RATE=0.02
