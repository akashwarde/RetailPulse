# ==============================================================================
# RetailPulse - Local Development Environment Variables
#
# To run this project locally, copy this file to '.env':
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL (Transactional Source DB & Warehouse DB)
# ------------------------------------------------------------------------------
POSTGRES_USER=retail
POSTGRES_PASSWORD=replace_with_a_strong_password
SOURCE_DB=source_db
WAREHOUSE_DB=warehouse_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. MinIO S3-Compatible Object Store (Bronze / Silver / Quarantine Lake)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=retailadmin
MINIO_ROOT_PASSWORD=replace_with_another_strong_password
MINIO_BUCKET=retailpulse
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 3. Apache Airflow Orchestration
# ------------------------------------------------------------------------------
# User ID for container file ownership (50000 standard or $(id -u) on Linux)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_PASSWORD=replace_with_an_admin_password

# ------------------------------------------------------------------------------
# 4. Redpanda / Kafka Streaming
# ------------------------------------------------------------------------------
# Host applications connect via localhost:19092; containers connect via redpanda:9092
REDPANDA_BROKER=localhost:19092
REDPANDA_CONTAINER_BROKER=redpanda:9092
REDPANDA_ORDERS_TOPIC=orders_stream
REDPANDA_DLQ_TOPIC=orders_dlq

# ------------------------------------------------------------------------------
# 5. Simulated Order Producer Settings
# ------------------------------------------------------------------------------
PRODUCER_RATE_PER_SEC=5.0
PRODUCER_INVALID_RATE=0.03
PRODUCER_LATE_RATE=0.02

# ------------------------------------------------------------------------------
# 6. Global Application Logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Added for application/session configuration.
AIRFLOW_WEBSERVER_SECRET_KEY=replace_with_a_random_session_secret
# Host path; Compose overrides this with /opt/airflow/data/source.
DATA_DIR=data/source
